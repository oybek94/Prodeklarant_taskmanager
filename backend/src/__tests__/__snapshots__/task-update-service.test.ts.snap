// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`updateTask — yon ta'sirlar > boshqa xodim: faqat ish vaqtidan tashqari 1`] = `
{
  "effects": [
    [
      "version",
      1,
      99,
    ],
    [
      "task.update",
      {
        "data": {
          "afterHoursDeclaration": true,
          "afterHoursPayer": "COMPANY",
          "updatedById": 99,
        },
        "where": {
          "id": 1,
        },
      },
    ],
    [
      "socket",
      99,
      "task:updated",
      {
        "changes": {
          "afterHoursDeclaration": true,
          "afterHoursPayer": "COMPANY",
        },
        "taskId": 1,
        "updatedBy": "Bek",
      },
    ],
  ],
  "result": {
    "body": {
      "id": 1,
      "updated": true,
    },
    "status": 200,
  },
}
`;


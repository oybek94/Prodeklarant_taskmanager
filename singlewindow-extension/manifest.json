{
  "manifest_version": 3,
  "name": "Prodeklarant",
  "version": "2.0",
  "description": "Prodeklarant invoysidan singlewindow.uz, app.expertiza.uz, cabinet.karantin.uz va cargo.customs.uz arizalarini to'ldiradi",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.singlewindow.uz/*", 
    "*://singlewindow.uz/*",
    "*://app.expertiza.uz/*",
    "*://cabinet.karantin.uz/*",
    "*://cargo.customs.uz/*",
    "http://localhost/*",
    "https://*.prodeklarant.uz/*",
    "https://prodeklarant.uz/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Prodeklarant to'ldirgich"
  },
  "content_scripts": [
    {
      "matches": ["*://*.singlewindow.uz/*", "*://singlewindow.uz/*", "*://app.expertiza.uz/*", "*://cabinet.karantin.uz/*", "*://cargo.customs.uz/*"],
      "js": ["content.js"]
    }
  ]
}

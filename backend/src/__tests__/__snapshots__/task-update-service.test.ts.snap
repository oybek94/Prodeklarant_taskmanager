exports[`updateTask — yon ta'sirlar > filial: USD, davlat to'lovi, invoys avto maydonlari 1`] = `
{
  "effects": [
    [
      "version",
      1,
      7,
    ],
    [
      "task.update",
      {
        "data": {
          "branchId": 4,
          "snapshotCertificatePayment": 10,
          "snapshotCertificatePayment_amount_original": 10,
          "snapshotCertificatePayment_amount_uzs": 126000,
          "snapshotCertificatePayment_currency": "USD",
          "snapshotCertificatePayment_exchange_rate": 1,
          "snapshotCertificatePayment_exchange_source": "MANUAL",
          "snapshotPsrPrice": 20,
          "snapshotPsrPrice_amount_original": 20,
          "snapshotPsrPrice_amount_uzs": 20,
          "snapshotPsrPrice_currency": "USD",
          "snapshotPsrPrice_exchange_rate": 1,
          "snapshotPsrPrice_exchange_source": "MANUAL",
          "snapshotWorkerPrice": 5,
          "snapshotWorkerPrice_amount_original": 5,
          "snapshotWorkerPrice_amount_uzs": 5,
          "snapshotWorkerPrice_currency": "USD",
          "snapshotWorkerPrice_exchange_rate": 1,
          "snapshotWorkerPrice_exchange_source": "MANUAL",
          "updatedById": 7,
        },
        "where": {
          "id": 1,
        },
      },
    ],
    [
      "invoice.updateMany",
      {
        "data": {
          "branchId": 4,
        },
        "where": {
          "taskId": 1,
        },
      },
    ],
    [
      "invoice.update",
      {
        "data": {
          "additionalInfo": {
            "fssRegionExternalCode": "B",
            "fssRegionInternalCode": "1710",
            "fssRegionName": "Qo'qon",
            "other": 1,
            "shipmentPlace": "Qo'qon shahri",
          },
        },
        "where": {
          "id": 9,
        },
      },
    ],
    [
      "cmr",
      {
        "invoiceId": 9,
        "uploadedById": 7,
      },
    ],
    [
      "tir",
      {
        "invoiceId": 9,
        "uploadedById": 7,
      },
    ],
    [
      "socket",
      7,
      "task:updated",
      {
        "changes": {
          "branchId": 4,
        },
        "taskId": 1,
        "updatedBy": "Ali",
      },
    ],
  ],
  "result": {
    "body": {
      "id": 1,
      "updated": true,
    },
    "status": 200,
  },
}
`;


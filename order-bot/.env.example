# --- Gmail (IMAP) ---
# Xatlar JISMONAN yotgan quti ko'rsatiladi.
# docs@prodeklarant.uz -> oybek4536@gmail.com ga yo'naltirilgan, shuning uchun
# bu yerda Gmail akkaunti turadi (yo'naltiruvchi alias emas).
#
# Parol sifatida Gmail App Password kerak: https://myaccount.google.com/apppasswords
# Oddiy Gmail parolingiz ISHLAMAYDI.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=oybek4536@gmail.com
IMAP_PASSWORD=

# --- Telegram ---
# @BotFather'da yangi bot yaratib token oling
ORDER_BOT_TOKEN=
# `npm run chat-id` ishga tushiring (avval botga /start yozing)
ORDER_BOT_CHAT_ID=

# --- Ixtiyoriy ---
IMAP_MAILBOX=INBOX
# IDLE jim qolgan holat uchun zaxira tekshiruv oralig'i (daqiqa)
POLL_FALLBACK_MINUTES=5
# Ishga tushganda necha kunlik eski xatlarni ham ko'rib chiqsin (0 = faqat yangilari)
INITIAL_LOOKBACK_DAYS=0
